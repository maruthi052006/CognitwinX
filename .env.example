# ==============================================================================
# CognitwinX Environment Configuration Example
# Copy this file to .env and replace placeholder values with your credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Django Core
DJANGO_SECRET_KEY=your-secure-random-secret-key-min-50-chars
DJANGO_DEBUG=True
ALLOWED_HOSTS=*

# Database (PostgreSQL / PostGIS - leave default for SQLite local dev)
USE_POSTGIS=False
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis & Channels & Celery
USE_REDIS_CHANNELS=False
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ISRO Bhuvan Open API
BHUVAN_API_TOKEN=your_bhuvan_token_here
BHUVAN_WMS_URL=https://bhuvan-vec2.nrsc.gov.in/bhuvan/wms
BHUVAN_THEMATIC_WMS_URL=https://bhuvan-thematic.nrsc.gov.in/bhuvan/wms

# ISRO Bhoonidhi Open Data Access
BHOONIDHI_API_KEY=your_bhoonidhi_api_key_here
BHOONIDHI_USERNAME=your_bhoonidhi_username
BHOONIDHI_PASSWORD=your_bhoonidhi_password
BHOONIDHI_BASE_URL=https://bhoonidhi.nrsc.gov.in/bhoonidhi/api

# NASA Earthdata (GES DISC IMERG Rainfall Data)
NASA_EARTHDATA_TOKEN=your_nasa_earthdata_bearer_token_here
NASA_EARTHDATA_USERNAME=your_nasa_earthdata_username
NASA_EARTHDATA_PASSWORD=your_nasa_earthdata_password

# Copernicus Open Access / Sentinel-1 & 2
COPERNICUS_CLIENT_ID=your_copernicus_client_id
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret

# Twilio SMS Alerts (Optional, mock alerts active if unset)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_ENABLED=False

# Google Maps Platform (Photorealistic 3D Tiles / Map Tiles API)
# Register at console.cloud.google.com, enable "Map Tiles API", restrict to your domain
GOOGLE_MAPS_PLATFORM_API_KEY=your_google_maps_platform_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_platform_api_key_here

